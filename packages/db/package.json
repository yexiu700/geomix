{
  "name": "@geomix/db",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node scripts/prisma-cli.mjs generate && tsc -p tsconfig.build.json",
    "typecheck": "node scripts/prisma-cli.mjs generate && tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "node scripts/prisma-cli.mjs generate && vitest run",
    "prisma:validate": "node scripts/prisma-cli.mjs validate",
    "prisma:migrate": "node scripts/prisma-cli.mjs migrate deploy",
    "prisma:migrate:dev": "node scripts/prisma-cli.mjs migrate dev --skip-seed",
    "db:seed": "node scripts/prisma-cli.mjs generate && tsc -p tsconfig.build.json && node scripts/prisma-cli.mjs db seed"
  },
  "prisma": {
    "seed": "node dist/seed-cli.js"
  },
  "dependencies": {
    "@geomix/prompts": "workspace:*",
    "@geomix/shared": "workspace:*",
    "@prisma/client": "5.22.0"
  },
  "devDependencies": {
    "@geomix/config": "workspace:*",
    "@types/node": "^22.19.1",
    "eslint": "^9.39.1",
    "prisma": "5.22.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
