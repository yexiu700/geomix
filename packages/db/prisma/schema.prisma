// GeoMix 2.0 domain schema (Brand + BrandMarket dual-market GEO architecture).
// CHECK constraints and `CREATE EXTENSION IF NOT EXISTS vector` live in the
// initial migration (`20261116120000_init`). Prisma 5.22's `extensions = [vector]`
// preview never settles, so the extension stays in SQL where it is idempotent.
// The HNSW index on BrandFactChunk is declared here by name and built with
// `USING hnsw (embedding vector_cosine_ops)` in migration `20261120100000_geomix_v2_domain_schema`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===================== 枚举 =====================
enum UserRole {
  MERCHANT
  ADMIN
}

enum BillingMode {
  SHADOW // 影子计费：不拦截、不实扣，完整记账原价
  STRICT // 正式计费：校验余额并实扣
}

enum LedgerStatus {
  RESERVED
  SETTLED
  RELEASED
}

enum ReservationStatus {
  OPEN
  CLOSED
}

enum QuotaKey {
  MAIN_KEYWORD
  QUESTION
  AI_WRITE
  STORAGE_BYTES
  PUBLISH
  SOCIAL_AUTH
}

enum TaskStatus {
  QUEUED
  RUNNING
  PAUSED
  COMPLETED
  PARTIAL
  FAILED
  CANCELLED
}

enum ItemStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  SKIPPED
}

enum GeoMarket {
  CN
  GLOBAL
}

enum BrandFactSlot {
  PRODUCT_SPECS
  DIFFERENTIATORS
  CREDENTIALS
  CASE_STUDIES
  EXTRA_DOC
}

enum FactSourceType {
  MANUAL
  URL_EXTRACT
  DOC_UPLOAD
  STUDIO_FEEDBACK
}

enum FactIndexStatus {
  NONE
  INDEXING
  READY
  FAILED
}

enum BrandMediaOrigin {
  PRODUCT_UPLOAD
  AI_INLINE_GEN
}

enum VisibilityTriggerType {
  MANUAL
  RETEST
}

enum GeoBriefSource {
  AUTO_GAP
  LOW_RANK
  SENTIMENT_RISK
  FANOUT_CLUSTER
  CITATION_COUNTER
  MANUAL
}

enum GeoRecipe {
  AUTHORITY_GUIDE
  COMPARISON_MATRIX
  OBJECTION_FAQ
  CITATION_COUNTER
}

enum GeoTargetFormat {
  CN_DEEP_REVIEW
  CN_COMMUNITY_QA
  GLOBAL_AUTHORITY_GUIDE
  GLOBAL_COMMUNITY_DISCUSSION
}

enum GeoBriefStatus {
  OPEN
  WRITING
  DONE
  DISMISSED
}

enum GeoArticleStatus {
  DRAFT
  READY
  PUBLISHED
}

enum CitationSourceKind {
  OWNED
  COMPETITOR
  SOCIAL
  AUTHORITY
  ECOMMERCE
  OTHER
}

enum ChannelProvider {
  SHOPIFY
  WORDPRESS
  WEBFLOW
  WEBHOOK
  REDDIT_ASSIST
  QUORA_ASSIST
  SOCIAL_THREAD_ASSIST
  PR_PACKET
  CN_COMMUNITY_ASSIST
}

enum ChannelConnectionStatus {
  ACTIVE
  INVALID
  DISABLED
}

enum DistributionMode {
  L1_API
  L3_COMMUNITY_ASSIST
  L3_PR_PACKET
}

enum DistributionTaskStatus {
  DRAFT_VARIANT
  READY_TO_PUBLISH
  PUBLISHING
  DRAFT_PUSHED
  PUBLISHED
  FAILED
  ARCHIVED
}

enum CrawlProbeStatus {
  PENDING
  OK
  WARNING
  BLOCKED
  FAILED
}

enum RetestScheduleStatus {
  PENDING
  RUNNING
  COMPLETED
  SKIPPED_INSUFFICIENT_POINTS
  SKIPPED_NO_ENGINE
  FAILED
  CANCELLED
}

// ===================== 底座 =====================
model Tenant {
  id          String       @id @default(cuid())
  name        String
  billingMode BillingMode? // 为空时取全局 BILLING_MODE
  expiresAt   DateTime
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  users                  User[]
  wallet                 Wallet?
  quotas                 Quota[]
  reservations           PointReservation[]
  pointLogs              PointLog[]
  moneyLogs              MoneyLog[]
  verification           Verification?
  workRuns               WorkRun[]
  workUnits              WorkUnit[]
  activeWorks            ActiveWork[]
  brands                 Brand[]
  brandMarkets           BrandMarket[]
  brandFacts             BrandFact[]
  brandFactChunks        BrandFactChunk[]
  brandMediaAssets       BrandMediaAsset[]
  visibilityRuns         VisibilityRun[]
  visibilityObservations VisibilityObservation[]
  visibilityCitations    VisibilityCitation[]
  geoBriefs              GeoBrief[]
  geoArticles            GeoArticle[]
  geoPublishRecords      GeoPublishRecord[]
  geoBatchJobs           GeoBatchJob[]
  promptPreference       PromptPreference?
  channelConnections     ChannelConnection[]
  geoDistributionTasks   GeoDistributionTask[]
  geoRetestSchedules     GeoRetestSchedule[]
}

model User {
  id           String    @id @default(cuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  username     String    @unique
  passwordHash String
  nickname     String?
  role         UserRole  @default(MERCHANT)
  uiPrefs      Json? // 菜单折叠等界面偏好
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())

  @@index([tenantId])
}

model Wallet {
  tenantId       String   @id
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  points         Int      @default(0) // 账面点数（含冻结）
  pointsReserved Int      @default(0) // 冻结中
  money          Decimal  @default(0) @db.Decimal(12, 2)
  updatedAt      DateTime @updatedAt
  // 迁移追加：CHECK (points >= 0 AND "pointsReserved" >= 0 AND points >= "pointsReserved")
}

model Quota {
  tenantId String
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  key      QuotaKey
  limit    BigInt
  used     BigInt   @default(0)

  @@id([tenantId, key])
}

model PricingItem {
  action     String   @id // geo_write | visibility_check | inline_image_gen | geo_variant
  unitPoints Int
  enabled    Boolean  @default(true)
  updatedAt  DateTime @updatedAt
}

// 异步任务整单冻结单
model PointReservation {
  id        String            @id @default(cuid())
  tenantId  String
  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  refType   String // geo_article | geo_batch | visibility_run | inline_image_gen | geo_variant | geo_distribution
  refId     String
  shadow    Boolean           @default(false)
  frozen    Int
  settled   Int               @default(0)
  released  Int               @default(0)
  status    ReservationStatus @default(OPEN)
  createdAt DateTime          @default(now())
  closedAt  DateTime?
  logs      PointLog[]

  @@unique([refType, refId])
  @@index([status, createdAt])
}

// 点数明细（每个结算单元一条，幂等）
model PointLog {
  id            String            @id @default(cuid())
  tenantId      String
  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reservationId String?
  reservation   PointReservation? @relation(fields: [reservationId], references: [id])
  action        String // 同 PricingItem.action，或 admin_topup / refund
  title         String // 展示用「项目」
  unitKey       String // 幂等键，如 geo_article:<id> | vis_obs:<id>
  delta         Int // 实际变动（影子模式为 0）
  listPrice     Int // 原价（影子模式用于核算）
  detail        Json?
  balanceAfter  Int?
  status        LedgerStatus      @default(SETTLED)
  createdAt     DateTime          @default(now())

  @@unique([unitKey, action])
  @@index([tenantId, createdAt])
}

model MoneyLog {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title     String
  amount    Decimal  @db.Decimal(12, 2)
  remark    String?
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
}

model Verification {
  tenantId    String   @id
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  companyName String
  creditCode  String
  contact     String?
  phone       String?
  licenseUrl  String?
  status      String   @default("SUBMITTED") // SUBMITTED | APPROVED | REJECTED
  updatedAt   DateTime @updatedAt
}

model Announcement {
  id           String   @id @default(cuid())
  content      String
  enabled      Boolean  @default(true)
  sort         Int      @default(0)
  operatorId   String?
  operatorName String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String?
  userId    String?
  action    String // forbidden_blocked | admin_topup | billing_mode_change | llm_cost ...
  payload   Json?
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
}

// ===================== 队列框架 =====================
model WorkRun {
  id                String      @id @default(cuid())
  tenantId          String
  tenant            Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  queue             String
  kind              String
  refType           String
  status            TaskStatus  @default(QUEUED)
  taskName          String
  totalUnits        Int
  doneCount         Int         @default(0)
  failCount         Int         @default(0)
  skipCount         Int         @default(0)
  unitAiWrite       Int
  unitKbAddon       Int         @default(0)
  withKnowledgeBase Boolean     @default(false)
  quotaKey          String?
  lastError         String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  finishedAt        DateTime?
  units             WorkUnit[]
  active            ActiveWork?

  @@index([tenantId, createdAt])
  @@index([status, updatedAt])
}

model WorkUnit {
  id                String     @id @default(cuid())
  runId             String
  run               WorkRun    @relation(fields: [runId], references: [id], onDelete: Cascade)
  tenantId          String
  tenant            Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  seq               Int
  steps             Int
  step              Int        @default(0)
  status            ItemStatus @default(PENDING)
  attempts          Int        @default(0)
  failuresRemaining Int        @default(0)
  outputReady       Boolean    @default(false)
  quotaApplied      Boolean    @default(false)
  settled           Boolean    @default(false)
  released          Boolean    @default(false)
  executionToken    String?
  error             String?
  leaseOwner        String?
  // Absolute instants. Raw SQL and Prisma both use timestamptz so a session
  // time zone cannot make a live lease look expired.
  leaseUntil        DateTime?  @db.Timestamptz(3)
  startedAt         DateTime?  @db.Timestamptz(3)
  finishedAt        DateTime?  @db.Timestamptz(3)

  @@unique([runId, seq])
  @@index([tenantId, status])
  @@index([status, leaseUntil])
}

model ActiveWork {
  refType  String
  refId    String
  tenantId String
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  runId    String   @unique
  run      WorkRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  reason   String
  beatAt   DateTime @db.Timestamptz(3)
  workerId String?

  @@id([refType, refId])
  @@index([tenantId, beatAt])
}

// ===================== 品牌与双市场资产 =====================
model Brand {
  id                     String                  @id @default(cuid())
  tenantId               String
  tenant                 Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name                   String
  category               String
  truthAgreementSignedAt DateTime?
  truthAgreementIp       String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  markets                BrandMarket[]
  facts                  BrandFact[]
  factChunks             BrandFactChunk[]
  mediaAssets            BrandMediaAsset[]
  visibilityRuns         VisibilityRun[]
  visibilityObservations VisibilityObservation[]
  geoBriefs              GeoBrief[]
  geoArticles            GeoArticle[]
  geoPublishRecords      GeoPublishRecord[]
  geoBatchJobs           GeoBatchJob[]
  channelConnections     ChannelConnection[]
  geoDistributionTasks   GeoDistributionTask[]
  geoRetestSchedules     GeoRetestSchedule[]

  @@unique([tenantId, name])
  @@index([tenantId, createdAt])
}

model BrandMarket {
  id             String    @id @default(cuid())
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  brandId        String
  brand          Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  market         GeoMarket
  locale         String    @default("zh-CN")
  region         String    @default("CN")
  localBrandName String
  localCategory  String?
  aliases        String[]  @default([])
  ownedDomains   String[]  @default([])
  competitors    Json      @default("[]")
  seedPrompts    String[]  @default([])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  visibilityRuns         VisibilityRun[]
  visibilityObservations VisibilityObservation[]
  geoBriefs              GeoBrief[]
  geoArticles            GeoArticle[]
  geoPublishRecords      GeoPublishRecord[]
  geoBatchJobs           GeoBatchJob[]
  channelConnections     ChannelConnection[]
  geoDistributionTasks   GeoDistributionTask[]
  geoRetestSchedules     GeoRetestSchedule[]

  @@unique([brandId, market])
  @@index([tenantId, brandId])
  @@index([tenantId, market])
}

model BrandFact {
  id          String          @id @default(cuid())
  tenantId    String
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  brandId     String
  brand       Brand           @relation(fields: [brandId], references: [id], onDelete: Cascade)
  slot        BrandFactSlot
  title       String
  content     String
  sourceType  FactSourceType  @default(MANUAL)
  sourceUrl   String?
  indexStatus FactIndexStatus @default(NONE)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  chunks BrandFactChunk[]

  @@index([tenantId, brandId, slot])
  @@index([brandId, indexStatus])
}

model BrandFactChunk {
  id        String                       @id @default(cuid())
  tenantId  String
  tenant    Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  brandId   String
  brand     Brand                        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  factId    String
  fact      BrandFact                    @relation(fields: [factId], references: [id], onDelete: Cascade)
  seq       Int
  content   String
  embedding Unsupported("vector(1024)")?
  // 迁移里用 HNSW（vector_cosine_ops）。这里声明同名索引，避免 migrate dev 把它当成多余对象删掉。

  @@unique([factId, seq])
  @@index([tenantId, brandId])
  @@index([embedding], map: "idx_brand_fact_chunk_embedding")
}

model BrandMediaAsset {
  id        String           @id @default(cuid())
  tenantId  String
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  brandId   String
  brand     Brand            @relation(fields: [brandId], references: [id], onDelete: Cascade)
  origin    BrandMediaOrigin @default(PRODUCT_UPLOAD)
  title     String
  objectKey String           @unique
  thumbKey  String?
  url       String
  thumbUrl  String?
  mime      String
  bytes     Int
  width     Int
  height    Int
  aiPrompt  String?
  aiModel   String?
  usedCount Int              @default(0)
  createdAt DateTime         @default(now())

  @@index([tenantId, brandId, createdAt])
  @@index([tenantId, brandId, origin])
}

// ===================== AI 可见度诊断 =====================
model VisibilityRun {
  id                String                @id @default(cuid())
  tenantId          String
  tenant            Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  brandId           String
  brand             Brand                 @relation(fields: [brandId], references: [id], onDelete: Cascade)
  brandMarketId     String
  brandMarket       BrandMarket           @relation(fields: [brandMarketId], references: [id], onDelete: Cascade)
  name              String
  engines           String[]              @default([])
  prompts           String[]              @default([])
  triggerType       VisibilityTriggerType @default(MANUAL)
  retestArticleId   String?
  briefsGeneratedAt DateTime?
  totalChecks       Int
  doneCount         Int                   @default(0)
  failCount         Int                   @default(0)
  unitPrice         Int
  reservationId     String?
  status            TaskStatus            @default(QUEUED)
  lastError         String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  finishedAt        DateTime?

  observations VisibilityObservation[]
  geoBriefs    GeoBrief[]

  @@index([tenantId, status, createdAt])
  @@index([tenantId, brandMarketId, createdAt])
  @@index([tenantId, brandId, createdAt])
  @@index([retestArticleId])
}

model VisibilityObservation {
  id             String               @id @default(cuid())
  tenantId       String
  tenant         Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  runId          String
  run            VisibilityRun        @relation(fields: [runId], references: [id], onDelete: Cascade)
  brandId        String
  brand          Brand                @relation(fields: [brandId], references: [id], onDelete: Cascade)
  brandMarketId  String
  brandMarket    BrandMarket          @relation(fields: [brandMarketId], references: [id], onDelete: Cascade)
  promptText     String
  engine         String
  sampleIndex    Int                  @default(1)
  status         ItemStatus           @default(PENDING)
  collectorKind  String               @default("fake")
  answerText     String?
  brandMentioned Boolean              @default(false)
  brandPosition  Int?
  brandSentiment String?
  brandPassage   String?
  competitorHits Json?
  fanOutQueries  String[]             @default([])
  judgeModel     String?
  tokensIn       Int?
  tokensOut      Int?
  error          String?
  checkedAt      DateTime?
  createdAt      DateTime             @default(now())

  citations VisibilityCitation[]

  @@unique([runId, promptText, engine, sampleIndex])
  @@index([tenantId, brandMarketId, checkedAt])
  @@index([tenantId, brandId, checkedAt])
  @@index([tenantId, engine, brandMentioned])
}

model VisibilityCitation {
  id            String                @id @default(cuid())
  tenantId      String
  tenant        Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  observationId String
  observation   VisibilityObservation @relation(fields: [observationId], references: [id], onDelete: Cascade)
  url           String
  domain        String
  title         String?
  snippet       String?
  sourceKind    CitationSourceKind    @default(OTHER)
  position      Int
  createdAt     DateTime              @default(now())

  @@index([tenantId, domain, sourceKind])
  @@index([observationId, position])
}

// ===================== GEO 意见、写作台与复测闭环 =====================
model GeoBrief {
  id                   String          @id @default(cuid())
  tenantId             String
  tenant               Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  brandId              String
  brand                Brand           @relation(fields: [brandId], references: [id], onDelete: Cascade)
  brandMarketId        String
  brandMarket          BrandMarket     @relation(fields: [brandMarketId], references: [id], onDelete: Cascade)
  sourceType           GeoBriefSource
  sourceRunId          String?
  sourceRun            VisibilityRun?  @relation(fields: [sourceRunId], references: [id], onDelete: SetNull)
  sourceObservationIds String[]        @default([])
  sourceCitationUrl    String?
  targetPrompt         String
  priorityScore        Int             @default(50)
  diagnosisSummary     String
  recommendedRecipe    GeoRecipe
  targetFormat         GeoTargetFormat
  suggestedTitle       String
  outlineH2            Json            @default("[]")
  targetFanOuts        String[]        @default([])
  competitorFocus      String[]        @default([])
  matchedFactIds       String[]        @default([])
  missingFactHints     String[]        @default([])
  recommendedChannels  Json            @default("[]")
  status               GeoBriefStatus  @default(OPEN)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  articles GeoArticle[]

  @@index([tenantId, brandMarketId, status, priorityScore])
  @@index([tenantId, brandId, createdAt])
  @@index([sourceRunId])
}

model GeoArticle {
  id              String           @id @default(cuid())
  tenantId        String
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  brandId         String
  brand           Brand            @relation(fields: [brandId], references: [id], onDelete: Cascade)
  brandMarketId   String
  brandMarket     BrandMarket      @relation(fields: [brandMarketId], references: [id], onDelete: Cascade)
  briefId         String?
  brief           GeoBrief?        @relation(fields: [briefId], references: [id], onDelete: SetNull)
  batchJobId      String?
  batchJob        GeoBatchJob?     @relation(fields: [batchJobId], references: [id], onDelete: SetNull)
  recipe          GeoRecipe
  targetFormat    GeoTargetFormat
  title           String
  targetPrompt    String
  outlineJson     Json             @default("[]")
  contentMarkdown String
  contentHtml     String
  schemaJsonLd    Json             @default("{}")
  llmsTxtSnippet  String?
  geoScore        Int              @default(0)
  geoScoreDetail  Json             @default("{}")
  tags            String[]         @default([])
  status          GeoArticleStatus @default(DRAFT)
  model           String?
  tokensIn        Int?
  tokensOut       Int?
  complianceFlags Json?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  publishRecords    GeoPublishRecord[]
  distributionTasks GeoDistributionTask[]

  @@index([tenantId, brandMarketId, status, createdAt])
  @@index([tenantId, brandId, createdAt])
  @@index([tenantId, createdAt])
  @@index([briefId])
  @@index([batchJobId])
}

model GeoPublishRecord {
  id                 String               @id @default(cuid())
  tenantId           String
  tenant             Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  brandId            String
  brand              Brand                @relation(fields: [brandId], references: [id], onDelete: Cascade)
  brandMarketId      String
  brandMarket        BrandMarket          @relation(fields: [brandMarketId], references: [id], onDelete: Cascade)
  articleId          String
  article            GeoArticle           @relation(fields: [articleId], references: [id], onDelete: Cascade)
  publishedUrl       String
  channel            String
  publishedAt        DateTime             @default(now())
  baselineRunId      String?
  latestRetestRunId  String?
  beforeMetrics      Json?
  afterMetrics       Json?
  distributionTaskId String?
  distributionTask   GeoDistributionTask? @relation(fields: [distributionTaskId], references: [id], onDelete: SetNull)
  crawlStatus        CrawlProbeStatus     @default(PENDING)
  crawlCheckedAt     DateTime?
  crawlReportJson    Json?
  indexNowSubmitted  Boolean              @default(false)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  retestSchedules GeoRetestSchedule[]

  @@index([tenantId, brandMarketId, publishedAt])
  @@index([tenantId, articleId, createdAt])
  @@index([latestRetestRunId])
  @@index([distributionTaskId])
  @@index([crawlStatus, publishedAt])
}

model GeoBatchJob {
  id            String      @id @default(cuid())
  tenantId      String
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  brandId       String
  brand         Brand       @relation(fields: [brandId], references: [id], onDelete: Cascade)
  brandMarketId String
  brandMarket   BrandMarket @relation(fields: [brandMarketId], references: [id], onDelete: Cascade)
  briefIds      String[]    @default([])
  total         Int
  doneCount     Int         @default(0)
  failCount     Int         @default(0)
  unitPrice     Int
  reservationId String?
  status        TaskStatus  @default(QUEUED)
  lastError     String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  finishedAt    DateTime?

  articles GeoArticle[]

  @@index([tenantId, brandMarketId, createdAt])
  @@index([tenantId, status, createdAt])
}

model PromptPreference {
  tenantId             String   @id
  tenant               Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customToneNote       String?
  customForbiddenWords String[] @default([])
  recipeOverrides      Json?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

// ===================== 渠道分发与复测排期（GeoMix v2.1） =====================
model ChannelConnection {
  id                         String                  @id @default(cuid())
  tenantId                   String
  tenant                     Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  brandId                    String
  brand                      Brand                   @relation(fields: [brandId], references: [id], onDelete: Cascade)
  brandMarketId              String
  brandMarket                BrandMarket             @relation(fields: [brandMarketId], references: [id], onDelete: Cascade)
  provider                   ChannelProvider
  displayName                String
  siteBaseUrl                String
  credentialsCiphertext      String
  credentialsIv              String
  credentialsTag             String
  keyVersion                 Int                     @default(1)
  credentialHint             String
  configJson                 Json                    @default("{}")
  status                     ChannelConnectionStatus @default(ACTIVE)
  lastTestedAt               DateTime?
  lastError                  String?
  authType                   String                  @default("API_KEY")
  oauthAccessTokenCiphertext String?
  oauthExpiresAt             DateTime?
  createdAt                  DateTime                @default(now())
  updatedAt                  DateTime                @updatedAt

  distributionTasks GeoDistributionTask[]

  @@index([tenantId, brandMarketId, provider])
  @@index([tenantId, brandId])
}

model GeoDistributionTask {
  id                 String                 @id @default(cuid())
  tenantId           String
  tenant             Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  brandId            String
  brand              Brand                  @relation(fields: [brandId], references: [id], onDelete: Cascade)
  brandMarketId      String
  brandMarket        BrandMarket            @relation(fields: [brandMarketId], references: [id], onDelete: Cascade)
  articleId          String
  article            GeoArticle             @relation(fields: [articleId], references: [id], onDelete: Cascade)
  connectionId       String?
  connection         ChannelConnection?     @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  provider           ChannelProvider
  mode               DistributionMode
  channelLabel       String
  targetUrlHint      String?
  variantTitle       String
  variantSlug        String?
  variantMetaDesc    String?
  variantMarkdown    String
  variantHtml        String
  variantExtrasJson  Json                   @default("{}")
  preflightJson      Json?
  status             DistributionTaskStatus @default(DRAFT_VARIANT)
  publishAsDraft     Boolean                @default(true)
  remotePostId       String?
  remoteAdminUrl     String?
  remotePublishedUrl String?
  indexNowStatus     String?
  lastError          String?
  shareTokenHash     String?                @unique
  shareExpiresAt     DateTime?
  shareRevokedAt     DateTime?
  publishedAt        DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  publishRecords GeoPublishRecord[]

  @@index([tenantId, articleId, createdAt])
  @@index([tenantId, brandMarketId, status])
  @@index([connectionId])
}

model GeoRetestSchedule {
  id                  String               @id @default(cuid())
  tenantId            String
  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  brandId             String
  brand               Brand                @relation(fields: [brandId], references: [id], onDelete: Cascade)
  brandMarketId       String
  brandMarket         BrandMarket          @relation(fields: [brandMarketId], references: [id], onDelete: Cascade)
  publishRecordId     String
  publishRecord       GeoPublishRecord     @relation(fields: [publishRecordId], references: [id], onDelete: Cascade)
  milestoneDay        Int
  sampleCount         Int                  @default(1)
  dueAt               DateTime
  status              RetestScheduleStatus @default(PENDING)
  visibilityRunId     String?
  metricsSnapshotJson Json?
  skipReason          String?
  executedAt          DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@unique([publishRecordId, milestoneDay])
  @@index([status, dueAt])
  @@index([tenantId, brandMarketId, status])
  @@index([visibilityRunId])
}
