{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["NEXT_PUBLIC_API_BASE", "FEATURE_AI_IMAGE", "FEATURE_VISIBILITY"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "@geomix/db#typecheck": {
      "dependsOn": ["build", "^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": ["GEOMIX_DB_INTEGRATION", "GEOMIX_REDIS_INTEGRATION", "DATABASE_URL"],
      "passThroughEnv": ["GEOMIX_DB_INTEGRATION", "GEOMIX_REDIS_INTEGRATION", "DATABASE_URL"]
    },
    "@geomix/db#test": {
      "dependsOn": ["build", "^build"],
      "env": ["GEOMIX_DB_INTEGRATION", "GEOMIX_REDIS_INTEGRATION", "DATABASE_URL"],
      "passThroughEnv": ["GEOMIX_DB_INTEGRATION", "GEOMIX_REDIS_INTEGRATION", "DATABASE_URL"]
    }
  }
}
