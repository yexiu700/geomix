{
  "name": "@geomix/server",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && concurrently -k -n tsc,api,worker -c gray,cyan,magenta \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"node --watch dist/main.api.js\" \"node --watch dist/main.worker.js\"",
    "dev:api": "tsc -p tsconfig.build.json && node --watch dist/main.api.js",
    "dev:worker": "tsc -p tsconfig.build.json && node --watch dist/main.worker.js",
    "start:api": "node dist/main.api.js",
    "start:worker": "node dist/main.worker.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.940.0",
    "@bull-board/api": "6.14.0",
    "@bull-board/express": "6.14.0",
    "@geomix/db": "workspace:*",
    "@geomix/shared": "workspace:*",
    "@nestjs/common": "^10.4.22",
    "@nestjs/core": "^10.4.22",
    "@nestjs/platform-express": "^10.4.22",
    "@prisma/client": "5.22.0",
    "bullmq": "5.63.0",
    "dotenv": "^16.6.1",
    "ioredis": "5.8.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.34.5",
    "undici": "^7.16.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@geomix/config": "workspace:*",
    "@types/node": "^22.19.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
