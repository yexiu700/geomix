# GeoMix local development defaults.
# Copy to .env. These values are placeholders for a laptop, not production secrets.
# Do not commit a filled-in .env.

# --- HTTP ---
WEB_PORT=3000
API_PORT=3001
WEB_ORIGIN=http://localhost:3000

# --- PostgreSQL 16 + pgvector ---
POSTGRES_USER=geomix
POSTGRES_PASSWORD=geomix
POSTGRES_DB=geomix
DATABASE_URL=postgresql://geomix:geomix@localhost:5432/geomix?schema=public

# --- Redis 7 ---
REDIS_URL=redis://localhost:6379

# --- S3 / MinIO (local only) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=geomix
S3_ACCESS_KEY_ID=geomix
S3_SECRET_ACCESS_KEY=geomix-dev-only
S3_FORCE_PATH_STYLE=true

# --- Auth placeholders. Replace outside the repo before any shared environment. ---
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- Models. Development stays on the fake provider until real keys are injected outside git. ---
LLM_PROVIDERS={}
EMBEDDING_PROVIDER=fake
EMBEDDING_DIMENSIONS=1024
IMAGE_PROVIDER=fake
SEARCH_PROVIDER=link_list

# --- Billing ---
# SHADOW records the list price and does not deduct points.
# STRICT deducts points. The billing service is not part of this skeleton.
BILLING_MODE=SHADOW

# --- Features ---
FEATURE_AI_IMAGE=true
ARTICLE_RETENTION_DAYS=30
