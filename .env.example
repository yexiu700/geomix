# GeoMix local development defaults.
# Copy to .env. These values are placeholders for a laptop, not production secrets.
# Do not commit a filled-in .env.

# --- HTTP ---
WEB_PORT=3000
API_PORT=3001
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE=http://localhost:3001/api/v1

# --- PostgreSQL 16 + pgvector ---
POSTGRES_USER=geomix
POSTGRES_PASSWORD=geomix
POSTGRES_DB=geomix
DATABASE_URL=postgresql://geomix:geomix@localhost:5432/geomix?schema=public

# --- Redis 7 / BullMQ ---
REDIS_URL=redis://localhost:6379
# Queue key prefix. A test run should set its own prefix so it does not share dev jobs.
QUEUE_PREFIX=geomix
QUEUE_HEARTBEAT_MS=15000
QUEUE_HEARTBEAT_TTL_MS=120000
QUEUE_LEASE_MS=120000
QUEUE_UNIT_ATTEMPTS=3
QUEUE_BACKOFF_MS=1000
QUEUE_RECOVER_MS=60000
QUEUE_FACT_INDEX_CONCURRENCY=2
QUEUE_GEO_BATCH_CONCURRENCY=2
QUEUE_VISIBILITY_CONCURRENCY=2
QUEUE_DISTRIBUTION_CONCURRENCY=2
# Legacy v1 concurrency aliases (fallback only if QUEUE_GEO_BATCH_CONCURRENCY / QUEUE_FACT_INDEX_CONCURRENCY are unset)
QUEUE_WRITE_CONCURRENCY=4
QUEUE_REWRITE_CONCURRENCY=5
QUEUE_BATCH_CONCURRENCY=2
QUEUE_KB_CONCURRENCY=2
QUEUE_IMAGE_CONCURRENCY=2

# --- S3 / MinIO (local only) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=geomix
S3_ACCESS_KEY_ID=geomix
S3_SECRET_ACCESS_KEY=geomix-dev-only
S3_FORCE_PATH_STYLE=true

# --- Auth placeholders. Replace outside the repo before any shared environment. ---
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# Per connection address by default; set AUTH_TRUST_PROXY=true behind trusted Nginx/Caddy to honor X-Real-IP / X-Forwarded-For.
AUTH_TRUST_PROXY=false
AUTH_CAPTCHA_MAX=10
AUTH_CAPTCHA_WINDOW_SECONDS=600
AUTH_LOGIN_FAIL_MAX=5
AUTH_LOGIN_FAIL_WINDOW_SECONDS=900

# --- Models. Development stays on the fake provider until real keys are injected outside git. ---
# LLM_PROVIDERS={} keeps every scene on the deterministic fake provider.
# A non-empty document is { "providers": { "deepseek": { "kind": "openai", "baseUrl": "https://llm.example/v1", "apiKeyEnv": "DEEPSEEK_API_KEY", "cheapModel": "cheap-placeholder", "qualityModel": "quality-placeholder" }, "tongyi": { ... }, "doubao": { ... } }, "route": { "body": { "primary": "deepseek", "backup": ["tongyi", "doubao"] } } }.
# When route is omitted, body and rewrite use deepseek, then tongyi, then doubao. Vendor base URLs are not hardcoded.
# Token cost recorded by the adapter is a placeholder micro-unit. It does not change the wallet. Billing stays SHADOW unless an administrator switches it.
LLM_PROVIDERS={}
DEEPSEEK_API_KEY=
TONGYI_API_KEY=
DOUBAO_API_KEY=
LLM_TIMEOUT_MS=30000
LLM_STREAM_TIMEOUT_MS=240000
LLM_STREAM_IDLE_TIMEOUT_MS=45000
LLM_FALLBACK_FAKE=false
EMBEDDING_PROVIDER=fake
EMBEDDING_DIMENSIONS=1024
EMBEDDING_MODEL=bge-m3
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_TIMEOUT_MS=15000
IMAGE_PROVIDER=fake
IMAGE_BASE_URL=
IMAGE_MODEL=fake-image
IMAGE_API_KEY=
IMAGE_TIMEOUT_MS=30000
SEARCH_PROVIDER=link_list
SEARCH_REMOTE_ENDPOINT=
SEARCH_REMOTE_API_KEY=
SEARCH_TIMEOUT_MS=10000
FETCH_TIMEOUT_MS=10000
FETCH_MAX_BYTES=5242880
FETCH_MAX_REDIRECTS=3
ROBOTS_CACHE_MS=3600000
# Comma-separated SSRF allowlist for internal services (sonargate is allowed by default).
# Supports hostnames, *.domain wildcards, host:port, IPs, CIDRs, or URLs (e.g. sonargate,geo-obs.internal:8080,10.0.0.0/8).
SSRF_ALLOWLIST=
STORAGE_DRIVER=memory
STORAGE_MAX_OBJECT_BYTES=104857600
# Visibility collector mode:
# - fake: deterministic simulated demo responses (development / CI only; UI explicitly flags as simulated).
# - llm_api: real LLM calls routed by engine name in LLM_PROVIDERS (fails cleanly instead of writing fake text).
# - remote_scraper: external web-search / live AI engine scraper gateway via VISIBILITY_REMOTE_URL.
VISIBILITY_COLLECTOR=fake
VISIBILITY_REMOTE_URL=
VISIBILITY_REMOTE_HEALTH_URL=
VISIBILITY_REMOTE_API_KEY=
VISIBILITY_TIMEOUT_MS=30000
# Periodic engine availability refresh interval in ms (default 300000 = 5 minutes).
VISIBILITY_HEALTH_REFRESH_MS=300000
# Optional comma-separated manual engine overrides (e.g. deepseek,doubao).
VISIBILITY_ENABLED_ENGINES=
VISIBILITY_DISABLED_ENGINES=

# --- Billing ---
# Global default. A tenant with an empty billingMode inherits this value.
# SHADOW records the list price and does not deduct points.
# STRICT checks the available balance and deducts points.
# Do not change the default here; an administrator switches a tenant when billing goes live.
BILLING_MODE=SHADOW
# Orphan holds older than this are closed when no queued, paused, or freshly heartbeating job is registered.
BILLING_RECONCILE_AFTER_MS=7200000
BILLING_RECONCILE_INTERVAL_MS=900000

# --- Features ---
FEATURE_AI_IMAGE=true
FEATURE_VISIBILITY=true
ARTICLE_RETENTION_DAYS=30
DISTILL_MIN_VALID=5
GALLERY_MAX_INPUT_BYTES=104857600
COVER_WHEN_NO_IMAGE=true
AI_TASK_MIN_CHARS=500
REWRITE_SIM_MAX=0.35
REWRITE_BATCH_TIMEOUT_MS=300000
REWRITE_BATCH_ITEM_TIMEOUT_MS=65000
FACT_EXTRACT_RATE_LIMIT_MAX=10
FACT_EXTRACT_RATE_LIMIT_WINDOW_SECONDS=60
BRIEF_GENERATE_RATE_LIMIT_MAX=20
BRIEF_GENERATE_RATE_LIMIT_WINDOW_SECONDS=60
REWRITE_SECTION_RATE_LIMIT_MAX=20
REWRITE_SECTION_RATE_LIMIT_WINDOW_SECONDS=60
GEO_EVALUATE_RATE_LIMIT_MAX=60
GEO_EVALUATE_RATE_LIMIT_WINDOW_SECONDS=60
MARKET_AI_SUGGEST_RATE_LIMIT_MAX=15
MARKET_AI_SUGGEST_RATE_LIMIT_WINDOW_SECONDS=60

# --- Distribution & Channel Credentials (v2.1) ---
# 32-byte key (64 hex chars or base64) used by SecretBox (AES-256-GCM) to encrypt L1 CMS credentials.
# Leave empty for local writing-only development; validated lazily when encrypting/decrypting L1 connections.
CREDENTIAL_ENCRYPTION_KEY=
# Public base URL prefix for external PR/KOL share links (/share/pr/:token). Defaults to WEB_ORIGIN when empty.
PUBLIC_APP_URL=http://localhost:3000
# Parallelism & per-channel LLM timeout for multi-channel variant generation jobs (#363, #399).
GEO_VARIANT_CONCURRENCY=3
GEO_VARIANT_CHANNEL_TIMEOUT_MS=120000

# --- Marketing Website & Lead Capture ---
# Optional internal API base URL for Next.js SSR when NEXT_PUBLIC_API_BASE is relative (e.g. http://api:3001/api/v1 in Docker).
INTERNAL_API_BASE=
# Optional secret salt for one-way SHA-256 hashing of lead submitter IPs (falls back to JWT_ACCESS_SECRET when empty).
MARKETING_LEAD_IP_SALT=
# Anti-spam rate limits for POST /api/v2/public/leads (per IP and per normalized email).
MARKETING_LEAD_IP_RATE_LIMIT_MAX=10
MARKETING_LEAD_IP_RATE_LIMIT_WINDOW_SECONDS=600
MARKETING_LEAD_EMAIL_RATE_LIMIT_MAX=3
MARKETING_LEAD_EMAIL_RATE_LIMIT_WINDOW_SECONDS=3600

# --- Shopify OAuth 2.0 & WeChat Official Draft API (v2.2) ---
# Leave empty for local development; Shopify Custom App Token remains available as fallback.
SHOPIFY_OAUTH_CLIENT_ID=
SHOPIFY_OAUTH_CLIENT_SECRET=
SHOPIFY_OAUTH_SCOPES=read_content,write_content
# Optional override for WeChat Official API base URL (defaults to https://api.weixin.qq.com in runtime; overridable in tests).
WECHAT_API_BASE_URL=

# --- Local seed only. Change these outside git before any shared environment. ---
# Repeating the seed syncs the 4 GeoMix v2.1 default pricing items and cleans deprecated pricing keys.
# It does not reset points, passwords, expiry, quota limits, or quota usage.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=geomix-admin-dev
SEED_DEMO_USERNAME=demo
SEED_DEMO_PASSWORD=geomix-demo-dev
SEED_DEMO_POINTS=1000
SEED_DEMO_VALID_DAYS=365

# --- Ops / Staging / Production Compose & LLM Daily Cost Report (#24) ---
# Optional per-model cost rates in micro-yuan per 1k tokens (1 yuan = 1,000,000 micro-yuan).
# Example: {"deepseek/deepseek-chat":{"inputMicroPer1k":2000,"outputMicroPer1k":8000}}
# Leave {} to use placeholder micro-unit estimation; never affects tenant wallet points.
LLM_COST_RATES_JSON={}
LLM_TIMEOUT_MS_PROD=45000

# Container image registry coordinates used by docker-compose.prod.yml
GHCR_OWNER=yexiu700
IMAGE_TAG=latest
MINIO_ROOT_USER=geomix
MINIO_ROOT_PASSWORD=geomix-dev-only

# Optional containerized Nginx + HTTPS (--profile tls / deploy-staging.sh --with-tls)
NGINX_SERVER_NAME=staging.geomix.internal
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
NGINX_CERTS_DIR=./docker/nginx/certs
NGINX_ACME_WEBROOT=./docker/nginx/certbot-www
STAGING_SELF_SIGNED_TLS=false

# Backup & retention defaults for scripts/backup.sh and scripts/restore.sh
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=7

# --- Playwright E2E (#23) ---
E2E_BASE_URL=http://127.0.0.1:3000
E2E_API_BASE=http://127.0.0.1:3001/api/v1
E2E_PUBLIC_FIXTURE_HOST=public.e2e.example
E2E_MEMORY_MAX_OBJECTS=2000
NEXT_E2E_FAST_BUILD=0

